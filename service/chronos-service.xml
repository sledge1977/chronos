<service>
  <id>ChronosTimeService</id>
  <name>Chronos Time Server</name>
  <description>Provides a local NTP time server and an optional Chronos website.</description>

  <executable>%BASE%\chronos.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>

  <env name="PORT" value="8080"/>
  <env name="WEB_ENABLED" value="false"/>
  <env name="NTP_ADDR" value=":123"/>
  <env name="NTP_STRATUM" value="15"/>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
